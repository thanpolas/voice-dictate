{
  "permissions": {
    "allow": [
      "Bash(ls *)",
      "Bash(ls)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(file *)",
      "Bash(stat *)",
      "Bash(pwd)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(rm *)",
      "Bash(chmod *)",
      "Bash(ln *)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(brew *)",
      "Bash(ffmpeg *)",
      "Bash(whisper-cli *)",
      "Bash(open *)",
      "Bash(./install.sh)",
      "Bash(./install.sh *)",
      "Bash(./bin/dikta.sh *)",
      "Edit(*)",
      "Write(*)",
      "Skill",
      "Skill(*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "FILE=$(echo \"$CLAUDE_TOOL_INPUT\" | jq -r '.file_path // empty' 2>/dev/null); PROJ=$(git -C \"$(dirname \"$FILE\")\" rev-parse --show-toplevel 2>/dev/null); [ -n \"$FILE\" ] && grep -qF \"$(basename $(dirname \"$FILE\"))\" \"$PROJ/INVENTORY.md\" 2>/dev/null || echo \"CDE: '$FILE' written — verify INVENTORY.md covers this location.\""
          }
        ]
      }
    ]
  }
}
